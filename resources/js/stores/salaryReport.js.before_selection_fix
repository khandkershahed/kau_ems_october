                    let sumBasic = 0, sumAllow = 0, sumDeduct = 0, sumNet = 0;
                    records.forEach((r, idx) => {
                        const b = Number(r.basic_pay) || 0;
                        const a = Number(r.total_allowance) || 0;
                        const d = Number(r.total_deduction) || 0;
